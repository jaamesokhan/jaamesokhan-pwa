# Base URL of the Jaame Sokhan API. Empty = same origin as the PWA (recommended when the
# PWA is served behind the same domain as the API, e.g. via the included nginx config).
VITE_API_BASE_URL=https://jaamesokhan.ir
# Ganjoor API, used as a fallback for recitations.
VITE_GANJOOR_BASE_URL=https://api.ganjoor.net
# Dev server only: where /api is proxied to.
VITE_DEV_API_PROXY=https://jaamesokhan.ir
